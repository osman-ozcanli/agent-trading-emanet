# Copy to .env and fill in. .env is gitignored — never commit it.
# OKX credentials are NOT here: the okx CLI stores them in ~/.okx/config.toml

# Which okx CLI profile to use (demo | live)
OKX_PROFILE=demo

# Telegram notification channel (user-facing output / UX layer)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
